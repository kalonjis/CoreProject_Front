flowchart TD
    subgraph Frontend["Frontend (Angular)"]
        authService["AuthService"]
        authInterceptor["AuthInterceptor"]
        router["Router"]
        publicRoutes["Public Routes Config"]
        login["Login Component"]
        signup["Signup Component"]
        deviceConfirm["Device Confirmation"]
        accountConfirm["Account Confirmation"]
    end
    
    subgraph Backend["Backend (Spring Boot)"]
        jwtFilter["JWT Filter"]
        jwtUtil["JWT Util"]
        securityConfig["Security Config"]
        authServiceImpl["AuthService Implementation"]
        deviceService["Device Service"]
        mailerService["Mailer Service"]
        subgraph Tokens["Token Services"]
            baseTokenService["BaseTokenService"]
            refreshTokenService["RefreshTokenService"]
            pwdResetTokenService["PasswordResetTokenService"]
            accountConfirmTokenService["AccountConfirmationTokenService"]
            deviceConfirmTokenService["DeviceConfirmationTokenService"]
        end
    end
    
    subgraph Database["Database"]
        users[("Users")]
        devices[("Devices")]
        refreshTokens[("Refresh Tokens")]
        otherTokens[("Other Tokens")]
    end
    
    authService <--> authInterceptor
    authService --> router
    authInterceptor --> publicRoutes
    
    login --> authService
    signup --> authService
    deviceConfirm --> authService
    accountConfirm --> authService
    
    authService --> jwtFilter
    
    jwtFilter --> jwtUtil
    jwtFilter --> securityConfig
    
    authServiceImpl --> jwtUtil
    authServiceImpl --> deviceService
    authServiceImpl --> mailerService
    
    deviceService --> devices
    authServiceImpl --> users
    
    baseTokenService -.-> refreshTokenService
    baseTokenService -.-> pwdResetTokenService
    baseTokenService -.-> accountConfirmTokenService
    baseTokenService -.-> deviceConfirmTokenService
    
    refreshTokenService --> refreshTokens
    pwdResetTokenService --> otherTokens
    accountConfirmTokenService --> otherTokens
    deviceConfirmTokenService --> otherTokens
    
    classDef angular fill:#DD0031,stroke:#DD0031,color:white;
    classDef spring fill:#6DB33F,stroke:#6DB33F,color:white;
    classDef database fill:#3498DB,stroke:#3498DB,color:white;
    
    class authService,authInterceptor,router,publicRoutes,login,signup,deviceConfirm,accountConfirm angular;
    class jwtFilter,jwtUtil,securityConfig,authServiceImpl,deviceService,mailerService,baseTokenService,refreshTokenService,pwdResetTokenService,accountConfirmTokenService,deviceConfirmTokenService spring;
    class users,devices,refreshTokens,otherTokens database;
